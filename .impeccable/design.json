  "narrative": {
    "northStar": "The Night Desk",
    "overview": "The site reads like a desk lamp left on after the last ticket closed: a near-black field, one warm brass light, paper-white serif headlines, and the small monospace handwriting of someone who keeps notes. It is a working operator's site, not a template portfolio. Every page is quiet and typographic; the two places that get colour are the home page (a painted mountain under an ultramarine sky) and the room (a lamp-lit flat above a snowing Bjørvika). Both are scenes, and the interface sits on top of them in the same near-black glass.",
    "keyCharacteristics": [
      "Near-black ground, a single brass accent, warm paper text.",
      "Georgia for every heading; Avenir for prose; mono for labels, data, keys, and the lowercase voice.",
      "Hairline rules and underlines instead of boxes and fills.",
      "Title first, then a meta line: no labels above headings.",
      "Scenes (mountain, room) carry colour; chrome stays near-black glass."
    ],
    "rules": [
      {
        "name": "The One Lamp Rule",
        "body": "Brass is the only interface accent. If something brass cannot be clicked, pressed, or is not a status you should notice, it should not be brass.",
        "section": "colors"
      },
      {
        "name": "The Scene Owns Colour Rule",
        "body": "Saturated colour (ultramarine, the rug, neon, city light) lives inside scenes. Chrome laid over a scene stays ink glass with hairlines.",
        "section": "colors"
      },
      {
        "name": "The Title-Then-Meta Rule",
        "body": "A heading speaks first; its context (dates, role, status, counts) follows on a mono meta line below it. Nothing sits above a heading.",
        "section": "typography"
      },
      {
        "name": "The Lowercase Voice Rule",
        "body": "Mono text is lowercase. Proper nouns inside it stay lowercase too (\"bjørvika\", \"baton\") when it is the voice; data such as times and counts uses tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Flat Page Rule",
        "body": "If it is not floating over a scene or a photograph, it has no shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put context on a mono meta line under the heading (page-title then page-meta).",
      "Do keep brass for actions, keys, and \"soon\"; everything else is paper, stone, or ash.",
      "Do separate list entries with 1px hairlines and generous vertical padding instead of cards.",
      "Do keep scenes full bleed and lay chrome over them as ink glass with hairlines.",
      "Do mirror anything reachable only in 3D as plain HTML on the same page."
    ],
    "donts": [
      "Don't put labels or eyebrows above headings.",
      "Don't use section numbers unless they map to something the reader uses (the room's station keys do).",
      "Don't add shadows or fills to plain page content.",
      "Don't introduce a second accent colour in interface chrome.",
      "Don't ship generated imagery as product screenshots; captures must be real and carry provenance."
    ]
  }
}