---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resumeProfile } from "../lib/resume";
---

<BaseLayout title="Contact" description="Get in touch with Eirik Breen, senior systems consultant in Oslo.">
  <section class="page contact-page">
    <header class="page-head">
      <h1 class="page-title">Good conversations welcome.</h1>
      <p class="page-meta">oslo · replies arrive between terminal sessions</p>
      <p class="page-lede">
        Platform work, PCI Linux, GitOps, network HSMs, homelab notes, or an AI workflow that is actually useful. My
        inbox is open.
      </p>
    </header>

    <section class="direct" aria-labelledby="direct-route">
      <h2 class="section-title" id="direct-route">The direct route</h2>
      <a class="email-address" href={`mailto:${resumeProfile.email}`}>{resumeProfile.email}</a>
    </section>

    <section class="elsewhere" aria-labelledby="elsewhere-title">
      <h2 class="section-title" id="elsewhere-title">Elsewhere</h2>
      <ul class="rule-list">
        <li>
          <a href={resumeProfile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          <span>the sensible career version</span>
        </li>
        <li>
          <a href={resumeProfile.github} target="_blank" rel="noreferrer">GitHub</a>
          <span>code, experiments, loose screws</span>
        </li>
        <li>
          <a href="/resume">The CV</a>
          <span>dates, employers, the full stack</span>
        </li>
      </ul>
    </section>
  </section>
</BaseLayout>

<style>
  .contact-page {
    width: min(100%, var(--page));
  }

  .direct {
    margin-bottom: clamp(3.5rem, 9vw, 5rem);
    padding-block: 1.75rem 2rem;
    border-block: 1px solid var(--border);
  }

  .email-address {
    display: inline-block;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(2rem, 6.4vw, 3.6rem);
    letter-spacing: -0.04em;
    line-height: 1.15;
    overflow-wrap: anywhere;
    text-decoration-color: rgba(214, 180, 95, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }

  .email-address:hover {
    color: var(--text);
  }

  .elsewhere li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    padding-block: 1.1rem;
  }

  .elsewhere a {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.4rem;
    text-decoration-color: var(--faint);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .elsewhere a:hover {
    color: var(--accent);
  }

  .elsewhere span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }
</style>
