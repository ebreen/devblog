---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Room"
  description="A small first-person 3d room above Oslo at night. Look around, walk, poke at things, print the cv."
>
  <section class="room-page">
    <header class="room-header">
      <p class="eyebrow">room</p>
      <h1>the room</h1>
      <p class="lede">
        a small room on the tenth floor above bjørvika. the opera and the fjord
        are out the window. look around, walk, poke at things, print the cv.
      </p>
    </header>

    <div class="room-stage" id="room-stage">
      <canvas id="room-canvas"></canvas>

      <div class="room-loading">booting the room…</div>
      <p class="room-look-hint">
        <span class="room-look-hint-keyboard">click to look around</span>
        <span class="room-look-hint-touch">drag to look around</span>
      </p>

      <p class="room-prompt" hidden></p>

      <aside class="room-dialog" aria-live="polite" hidden>
        <p class="room-dialog-title"></p>
        <div class="room-dialog-lines"></div>
        <div class="room-dialog-status" hidden></div>
        <p class="room-dialog-linkrow" hidden>
          <a class="room-dialog-link" href="/">leave</a>
          <span class="arrow" aria-hidden="true">→</span>
        </p>
        <p class="room-dialog-close">esc — close</p>
      </aside>

      <div class="room-touch" aria-hidden="true">
        <div class="room-joystick">
          <div class="room-joystick-nub"></div>
        </div>
        <button type="button" class="room-interact-button">e</button>
      </div>

      <div class="room-fallback" hidden>
        <p>this room needs webgl. the same stuff, in boring html:</p>
        <p>
          <a href="/about">about</a> / <a href="/projects">made</a> /
          <a href="/resume">cv</a> / <a href="/blog">wrote</a> /
          <a href="/contact">email</a>
        </p>
      </div>
    </div>

    <p class="room-hint">
      <span class="room-hint-keyboard">click to look · wasd / arrows — walk · e — interact · esc — close</span>
      <span class="room-hint-touch">drag to look · pad to walk · tap e to interact</span>
    </p>

    <noscript>
      <p class="room-noscript">
        the room runs on javascript. without it:
        <a href="/about">about</a> / <a href="/projects">made</a> /
        <a href="/resume">cv</a> / <a href="/blog">wrote</a> /
        <a href="/contact">email</a>
      </p>
    </noscript>
  </section>
</BaseLayout>

<script>
  import { initRoom } from "../scripts/room/main";

  initRoom();
</script>

<style is:global>
  .room-page {
    width: 100%;
  }

  .room-header {
    width: min(100%, 36rem);
    margin-inline: auto;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .room-header h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.8rem, 9vw, 4.6rem);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .room-stage {
    position: relative;
    width: min(100vw - 2rem, 72rem);
    height: min(72vh, 42rem);
    min-height: 22rem;
    margin-inline: calc((100% - min(100vw - 2rem, 72rem)) / 2);
    overflow: hidden;
    border: 1px solid var(--border);
    background: #050505;
  }

  .room-stage canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    cursor: grab;
    touch-action: none;
  }

  .room-stage.is-looking canvas {
    cursor: none;
  }

  .room-look-hint {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end center;
    margin: 0;
    padding-bottom: 3.4rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    pointer-events: none;
    text-shadow: 0 1px 8px #050505;
  }

  .room-look-hint-touch {
    display: none;
  }

  .room-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: #050505;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    transition: opacity 400ms ease;
  }

  .room-loading.is-done {
    opacity: 0;
    pointer-events: none;
  }

  .room-prompt {
    position: absolute;
    bottom: 1.1rem;
    left: 50%;
    margin: 0;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border);
    background: rgba(9, 9, 9, 0.88);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .room-prompt-key {
    color: var(--accent);
  }

  .room-dialog {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    width: min(92%, 26rem);
    padding: 1rem 1.15rem 0.85rem;
    border: 1px solid var(--border);
    background: rgba(17, 17, 17, 0.96);
    transform: translateX(-50%);
  }

  .room-dialog-title {
    margin: 0 0 0.45rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .room-dialog-lines p {
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.7;
  }

  .room-dialog-status {
    margin-top: 0.65rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
  }

  .room-dialog-status p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.7;
  }

  .room-status-accent {
    color: var(--accent);
  }

  .room-status-muted {
    color: var(--muted);
  }

  .room-status-faint {
    color: var(--faint);
  }

  .room-status-note {
    margin-top: 0.35rem !important;
    color: var(--faint);
    font-size: 0.64rem !important;
  }

  .room-dialog-linkrow {
    margin: 0.75rem 0 0;
  }

  .room-dialog-link {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.98rem;
    text-decoration-color: var(--faint);
  }

  .room-dialog-link:hover {
    color: var(--accent);
  }

  .room-dialog-close {
    margin: 0.7rem 0 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
  }

  .room-touch {
    display: none;
  }

  .room-hint {
    width: min(100%, 36rem);
    margin: 0.9rem auto 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
  }

  .room-hint-touch {
    display: none;
  }

  .room-noscript {
    width: min(100%, 36rem);
    margin: 1rem auto 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .room-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.4rem;
    background: #050505;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-align: center;
  }

  @media (pointer: coarse) {
    .room-touch {
      display: block;
    }

    .room-hint-keyboard {
      display: none;
    }

    .room-hint-touch {
      display: inline;
    }

    .room-look-hint-keyboard {
      display: none;
    }

    .room-look-hint-touch {
      display: inline;
    }

    .room-prompt {
      bottom: 8.4rem;
    }

    .room-dialog {
      bottom: 8.2rem;
    }
  }

  .room-joystick {
    position: absolute;
    bottom: 1.1rem;
    left: 1.1rem;
    width: 6.6rem;
    height: 6.6rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: rgba(9, 9, 9, 0.4);
    touch-action: none;
  }

  .room-joystick-nub {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--faint);
    border-radius: 50%;
    background: var(--surface);
    transform: translate(-50%, -50%);
  }

  .room-interact-button {
    position: absolute;
    right: 1.1rem;
    bottom: 2.2rem;
    width: 3.6rem;
    height: 3.6rem;
    padding: 0;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: rgba(9, 9, 9, 0.55);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    cursor: pointer;
  }
</style>
