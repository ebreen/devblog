---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { sortBlogEntries, formatBlogDate, getReadingTime } from "../lib/blog";
import { getLatestCreation } from "../lib/projects";
import { resumeProfile } from "../lib/resume";

const allPosts = sortBlogEntries(await getCollection("blog"));
const latestPost = allPosts[0];
const latestCreation = getLatestCreation();
---

<BaseLayout title="Home">
  <section class="home-intro">
    <p class="home-id">eirik breen — oslo</p>

    <h1>i like sidequests</h1>

    <p class="home-copy">
      linux, homelabs, ai, and things that seemed like a good idea at midnight.
    </p>

    <nav class="home-links" aria-label="Explore the site">
      <a href="/about">about</a>
      <span aria-hidden="true">/</span>
      <a href="/projects">made</a>
      <span aria-hidden="true">/</span>
      <a href="/resume">cv</a>
      <span aria-hidden="true">/</span>
      <a href="/blog">wrote</a>
      <span aria-hidden="true">/</span>
      <a href="/room">room</a>
      <span aria-hidden="true">/</span>
      <span class="home-links-tail">
        <a href={resumeProfile.github} target="_blank" rel="noreferrer">github</a>
        <span aria-hidden="true">/</span>
        <span class="home-email">
          <a href={`mailto:${resumeProfile.email}`} aria-describedby="home-email-tip">email</a>
          <span id="home-email-tip" class="home-email-tip" role="tooltip">{resumeProfile.email}</span>
        </span>
      </span>
    </nav>

    {latestCreation && (
      <section class="latest-block latest-creation" aria-labelledby="latest-creation-title">
        <p class="latest-label">latest creation</p>
        <h2 id="latest-creation-title">
          <a href={latestCreation.href} target="_blank" rel="noreferrer">
            {latestCreation.homeTitle ?? latestCreation.title}
          </a>
        </h2>
        {latestCreation.homeCopy && latestCreation.homeCopy.length > 0 && (
          <p class="latest-copy">{latestCreation.homeCopy.join("\n")}</p>
        )}
      </section>
    )}

    {latestPost && (
      <section class="latest-block latest-note" aria-labelledby="latest-note-title">
        <p class="latest-label">latest note · {allPosts.length} in the archive</p>
        <h2 id="latest-note-title">
          <a href={`/blog/${latestPost.slug}`}>{latestPost.data.title}</a>
        </h2>
        <p class="latest-meta">
          <time datetime={latestPost.data.date.toISOString()}>{formatBlogDate(latestPost.data.date)}</time>
          <span aria-hidden="true"> · </span>
          {getReadingTime(latestPost)}
        </p>
      </section>
    )}
  </section>
</BaseLayout>

<style>
  .home-intro {
    width: 100%;
    animation: home-intro-rise 1.2s cubic-bezier(0.16, 1, 0.3, 1) 140ms both;
  }

  .home-id,
  .home-copy,
  .latest-label,
  .latest-meta,
  .latest-copy {
    font-family: var(--font-mono);
  }

  .home-id,
  h1,
  .home-copy,
  .home-links a,
  .latest-label,
  .latest-meta,
  .latest-copy,
  .latest-block h2 a {
    text-shadow: 0 2px 22px rgba(6, 18, 48, 0.72);
  }

  .home-id {
    margin-bottom: 1.2rem;
    color: var(--text-secondary);
    font-size: 0.78rem;
    text-transform: lowercase;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 4.4rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .home-copy {
    max-width: 32rem;
    margin: 1.15rem 0 0;
    color: var(--text-secondary);
    font-size: 0.86rem;
    line-height: 1.75;
  }

  .home-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    margin-top: 1.15rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .home-links > span {
    color: var(--faint);
  }

  .home-links a {
    color: var(--text);
    text-decoration-color: var(--faint);
  }

  .home-links a:nth-of-type(4) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .home-email {
    position: relative;
    display: inline-flex;
  }

  .home-links-tail {
    display: inline-flex;
    flex-wrap: nowrap;
    gap: 0.35rem 0.8rem;
    align-items: baseline;
    white-space: nowrap;
  }

  .home-email-tip {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.55rem);
    z-index: 2;
    padding: 0.38rem 0.58rem;
    background: rgba(8, 16, 40, 0.9);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    line-height: 1.3;
    white-space: nowrap;
    border: 1px solid rgba(239, 236, 227, 0.16);
    border-radius: 0.2rem;
    box-shadow: 0 10px 28px rgba(6, 18, 48, 0.42);
    opacity: 0;
    pointer-events: none;
    user-select: all;
    transform: translateY(0.28rem);
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .home-email-tip::before {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 0.6rem;
  }

  .home-email-tip::after {
    content: "";
    position: absolute;
    top: 100%;
    right: 0.7rem;
    border: 5px solid transparent;
    border-top-color: rgba(8, 16, 40, 0.9);
  }

  .home-email:hover .home-email-tip,
  .home-email:focus-within .home-email-tip {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .latest-block {
    margin-top: 1.7rem;
  }

  .latest-label,
  .latest-meta,
  .latest-copy {
    color: var(--muted);
    font-size: 0.66rem;
    letter-spacing: 0.055em;
    text-transform: lowercase;
  }

  .latest-label {
    margin-bottom: 0.65rem;
  }

  .latest-block h2 {
    max-width: 30rem;
    margin: 0;
    font-size: clamp(1.35rem, 4vw, 1.7rem);
    line-height: 1.28;
  }

  .latest-block h2 a {
    color: var(--text);
    text-decoration-color: var(--faint);
  }

  .latest-meta,
  .latest-copy {
    margin: 0.75rem 0 0;
  }

  .latest-copy {
    max-width: 32rem;
    letter-spacing: 0.03em;
    line-height: 1.7;
    white-space: pre-line;
  }

  @media (max-width: 34rem) {
    h1 {
      font-size: clamp(2.7rem, 14vw, 3.6rem);
    }

    .home-copy {
      font-size: 0.8rem;
    }

    .latest-block {
      margin-top: 1.5rem;
    }

    .home-email-tip {
      top: calc(100% + 0.55rem);
      bottom: auto;
      left: 0;
      right: auto;
    }

    .home-email-tip::before {
      top: auto;
      bottom: 100%;
    }

    .home-email-tip::after {
      top: auto;
      bottom: 100%;
      left: 0.7rem;
      right: auto;
      border-top-color: transparent;
      border-bottom-color: rgba(8, 16, 40, 0.9);
    }
  }

  @keyframes home-intro-rise {
    from {
      opacity: 0.15;
      transform: translateY(26vh);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
