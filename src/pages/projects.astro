---
import BaseLayout from "../layouts/BaseLayout.astro";
import { isExternal, projectLinkLabel, projects, projectStatusLabel, type Project } from "../lib/projects";

const featured = projects.find((project) => project.image);
const rest = projects.filter((project) => project !== featured);
const live = projects.filter((project) => project.status === "live").length;
const soon = projects.filter((project) => project.status === "soon").length;

const words = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
const count = (n: number): string => words[n] ?? String(n);

const statusClass = (project: Project): string => `status status-${project.status}`;
---

<BaseLayout title="Made" description="Side projects and after-hours tools by Eirik Breen, including Baton, ModelTable, and PixelWitness.">
  <section class="page projects-page">
    <header class="page-head">
      <h1 class="page-title">Things I built.</h1>
      <p class="page-meta">
        {count(projects.length)} projects · {count(live)} live
        {soon > 0 && <> · <strong>{count(soon)} out soon</strong></>}
      </p>
      <p class="page-lede">
        Side projects from evenings and the homelab. I start them because I need the tool, then keep going if the
        idea still holds up.
      </p>
    </header>

    {
      featured && featured.image && (
        <article class="feature" id={featured.id} aria-labelledby={`project-${featured.id}`}>
          <div class="feature-text">
            <h2 id={`project-${featured.id}`}>{featured.title}</h2>
            <p class="project-meta">
              <span>{featured.category}</span>
              <span class={statusClass(featured)}>{projectStatusLabel(featured.status)}</span>
            </p>
            <p class="project-description">{featured.summary}</p>
            <ul class="technologies" aria-label={`${featured.title} technologies`}>
              {featured.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
            {featured.href ? (
              <a
                class="project-link"
                href={featured.href}
                target={isExternal(featured) ? "_blank" : undefined}
                rel={isExternal(featured) ? "noreferrer" : undefined}
              >
                {projectLinkLabel(featured)}
              </a>
            ) : (
              <p class="project-pending">Not public yet. The link goes here when it ships.</p>
            )}
          </div>

          <figure class="feature-shot">
            <img
              src={featured.image.src}
              alt={featured.image.alt}
              width={featured.image.width}
              height={featured.image.height}
              decoding="async"
              fetchpriority="high"
            />
            {featured.image.caption && <figcaption>{featured.image.caption}</figcaption>}
          </figure>
        </article>
      )
    }

    <ol class="project-list rule-list">
      {
        rest.map((project) => (
          <li>
            <article class="project" id={project.id} aria-labelledby={`project-${project.id}`}>
              <div class="project-head">
                <h2 id={`project-${project.id}`}>{project.title}</h2>
                <span class={statusClass(project)}>{projectStatusLabel(project.status)}</span>
              </div>
              <p class="project-category">{project.category}</p>
              <p class="project-description">{project.summary}</p>

              <div class="project-foot">
                <ul class="technologies" aria-label={`${project.title} technologies`}>
                  {project.technologies.map((technology) => (
                    <li>{technology}</li>
                  ))}
                </ul>
                {project.href && (
                  <a
                    class="project-link"
                    href={project.href}
                    target={isExternal(project) ? "_blank" : undefined}
                    rel={isExternal(project) ? "noreferrer" : undefined}
                  >
                    {projectLinkLabel(project)}
                  </a>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ol>

    <aside class="github-note">
      <p>More experiments, and a few unfinished ones, live on GitHub.</p>
      <a class="text-link" href="https://github.com/ebreen" target="_blank" rel="noreferrer">Open GitHub</a>
    </aside>
  </section>
</BaseLayout>

<style>
  .projects-page {
    width: min(100%, var(--page));
  }

  /* ---------- featured ---------- */

  /* Text stays on the page column; the screenshot hangs into the right margin. */
  .feature {
    --feature-width: min(100vw - 2rem, var(--page-wide));
    position: relative;
    left: 50%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    width: var(--feature-width);
    margin: 0 0 clamp(4rem, 9vw, 5.5rem);
    padding-left: max(0px, (var(--feature-width) - var(--page)) / 2);
    transform: translateX(-50%);
    scroll-margin-top: 2rem;
  }

  .feature h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(2.1rem, 4.6vw, 3rem);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .feature .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0.9rem 0 1.1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: lowercase;
  }

  .feature .project-description {
    font-size: 0.98rem;
  }

  .feature-shot {
    margin: 0;
  }

  .feature-shot img {
    width: 100%;
    height: auto;
    border: 1px solid rgba(239, 236, 227, 0.1);
    border-radius: 0.35rem;
    background: #111;
    box-shadow:
      0 24px 60px -18px rgba(0, 0, 0, 0.75),
      0 2px 6px rgba(0, 0, 0, 0.4);
  }

  .feature-shot figcaption {
    margin-top: 0.8rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    line-height: 1.6;
  }

  .project-pending {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.86rem;
  }

  /* ---------- list ---------- */

  .project {
    padding-block: 1.9rem;
    scroll-margin-top: 2rem;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .project h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.4rem, 3.4vw, 1.75rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .project-category {
    margin: 0.4rem 0 0.85rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: lowercase;
  }

  .project-description {
    margin: 0 0 1rem;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .project-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    list-style: none;
  }

  .feature .technologies {
    margin-bottom: 1.25rem;
  }

  .technologies li:not(:last-child)::after {
    margin-right: 0.55rem;
    content: ",";
  }

  .project-link {
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    text-decoration-color: rgba(214, 180, 95, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .project-link:hover {
    color: var(--text);
  }

  .github-note {
    padding-top: 2rem;
  }

  .github-note p {
    margin: 0 0 0.6rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  @media (max-width: 48rem) {
    .feature {
      grid-template-columns: 1fr;
      left: auto;
      width: 100%;
      padding-left: 0;
      transform: none;
    }

    .feature-shot {
      order: -1;
    }
  }
</style>
