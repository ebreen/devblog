---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatProjectIndex, projects, projectStatusLabel } from "../lib/projects";
---

<BaseLayout title="Made" description="Side projects and after-hours tools by Eirik Breen.">
  <section class="page projects-page">
    <header class="intro">
      <p class="kicker">Made</p>
      <h1>Things I built.</h1>
      <p class="lede">
        Side projects from evenings and the homelab. I start them because I need the tool, then keep going if the
        idea still holds up.
      </p>
    </header>

    <ol class="project-list">
      {
        projects.map((project, index) => (
          <li>
            <article class="project" aria-labelledby={`project-${project.id}`}>
              <header class="project-meta">
                <span>{formatProjectIndex(index)}</span>
                <span>{projectStatusLabel(project.status)}</span>
              </header>

              <p class="section-label">{project.category}</p>
              <h2 id={`project-${project.id}`}>{project.title}</h2>
              <p class="project-description">{project.summary}</p>

              <ul class="technologies" aria-label={`${project.title} technologies`}>
                {project.technologies.map((technology) => (
                  <li>{technology}</li>
                ))}
              </ul>

              <a class="project-link" href={project.href} target="_blank" rel="noreferrer">
                View repository
              </a>
            </article>
          </li>
        ))
      }
    </ol>

    <aside class="github-note">
      <p>More experiments, and a few unfinished ones, live on GitHub.</p>
      <a href="https://github.com/ebreen" target="_blank" rel="noreferrer">Open GitHub</a>
    </aside>
  </section>
</BaseLayout>

<style>
  .projects-page {
    width: min(100%, 40rem);
    margin-inline: auto;
  }

  .intro {
    margin-bottom: clamp(2.75rem, 7vw, 4rem);
  }

  .kicker,
  .section-label,
  .project-meta,
  .technologies {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  .kicker,
  .section-label {
    margin: 0 0 0.85rem;
  }

  h1,
  h2 {
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 400;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 3.15rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .lede {
    max-width: 34rem;
    margin: 1.15rem 0 0;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .project {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .project-meta span:last-child {
    color: var(--faint);
  }

  .project h2 {
    margin: 0 0 0.7rem;
    font-size: clamp(1.35rem, 3.4vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .project-description {
    margin: 0 0 1rem;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .technologies li:not(:last-child)::after {
    margin-right: 0.55rem;
    color: var(--faint);
    content: ",";
  }

  .project-link,
  .github-note a {
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .project-link:hover,
  .github-note a:hover {
    color: var(--text);
  }

  .github-note {
    padding-top: 1.75rem;
  }

  .github-note p {
    max-width: 34rem;
    margin: 0 0 0.7rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>
