---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not Found">
  <section class="page not-found-page">
    <header class="page-head">
      <h1 class="page-title">Nothing is running here.</h1>
      <p class="page-meta">404 · that route wandered off</p>
      <p class="page-lede">The page may have moved, or the URL is experimenting without supervision.</p>
    </header>
    <nav class="error-actions" aria-label="Somewhere else to go">
      <a href="/">Back home</a>
      <a href="/blog">Browse the notes</a>
      <a href="/room">Sit in the room</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found-page {
    display: flex;
    min-height: 56vh;
    flex-direction: column;
    justify-content: center;
  }

  .not-found-page .page-head {
    margin-bottom: 2.5rem;
  }

  .not-found-page .page-title {
    max-width: 10ch;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .error-actions a {
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    text-decoration-color: rgba(214, 180, 95, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .error-actions a:hover {
    color: var(--text);
  }
</style>
