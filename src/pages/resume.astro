---
import BaseLayout from "../layouts/BaseLayout.astro";
import { isExternal, projectHref, projects } from "../lib/projects";
import { displayUrl, education, experience, resumeProfile, skillGroups } from "../lib/resume";

// Shipped work only: unreleased projects stay off the printed CV.
const selectedWork = projects.filter((project) => project.status !== "soon").slice(0, 4);
---

<BaseLayout
  title="Resume"
  description="Resume for Eirik Breen, senior systems consultant at Orange Business in Oslo. Linux, Kubernetes, GitOps, and PCI DSS."
>
  <article class="page resume-page">
    <header class="intro">
      <h1 class="page-title">{resumeProfile.name}</h1>
      <p class="role-line">{resumeProfile.role} · {resumeProfile.location}</p>
      <p class="lede">{resumeProfile.intro}</p>

      <div class="intro-actions">
        <ul class="resume-contact">
          <li>
            <a class="text-link" href={`mailto:${resumeProfile.email}`}>{resumeProfile.email}</a>
          </li>
          <li class="print-only">
            <a href={resumeProfile.linkedin}>{displayUrl(resumeProfile.linkedin)}</a>
          </li>
          <li class="print-only">
            <a href={resumeProfile.github}>{displayUrl(resumeProfile.github)}</a>
          </li>
        </ul>
        <button class="print-button no-print" type="button" data-print-resume>
          Print / save PDF
        </button>
      </div>
    </header>

    <section class="resume-section" aria-labelledby="experience-title">
      <h2 id="experience-title">Professional experience</h2>

      <ol class="experience-list">
        {
          experience.map((role) => (
            <li class="experience">
              <p class="experience-dates">
                <time datetime={role.startDateTime}>{role.start}</time>
                <span aria-hidden="true"> — </span>
                {role.current ? (
                  <time datetime={new Date().toISOString().slice(0, 7)}>{role.end}</time>
                ) : (
                  <time datetime={role.endDateTime}>{role.end}</time>
                )}
              </p>

              <div class="experience-body">
                <h3>{role.title}</h3>
                <p class="experience-org">
                  {role.company}
                  <span aria-hidden="true"> · </span>
                  {role.location}
                </p>

                <ul class="highlights">
                  {role.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>

                {role.stack && role.stack.length > 0 && (
                  <p class="experience-stack">
                    <span>Daily stack</span>
                    {role.stack.join(", ")}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="resume-section resume-keep" aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>

      <ol class="experience-list">
        {
          education.map((item) => (
            <li class="experience">
              <p class="experience-dates">
                <time datetime={item.startDateTime}>{item.start}</time>
                <span aria-hidden="true"> — </span>
                <time datetime={item.endDateTime}>{item.end}</time>
              </p>

              <div class="experience-body">
                <h3>{item.title}</h3>
                <p class="experience-org">
                  {item.school}
                  <span aria-hidden="true"> · </span>
                  {item.location}
                </p>
                {item.detail && <p>{item.detail}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="resume-section resume-keep" aria-labelledby="stack-title">
      <h2 id="stack-title">What I work with</h2>

      <div class="skill-grid">
        {
          skillGroups.map((group) => (
            <section class="skill-group" aria-labelledby={`skill-${group.id}`}>
              <h3 id={`skill-${group.id}`}>{group.title}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section class="resume-section resume-keep" aria-labelledby="selected-work-title">
      <h2 id="selected-work-title">After-hours tools</h2>
      <p class="section-copy no-print">A few personal projects that show how I like to build. The full list is on the made page.</p>

      <ol class="work-list">
        {
          selectedWork.map((project) => (
            <li>
              <h3>
                <a
                  href={projectHref(project)}
                  target={isExternal(project) ? "_blank" : undefined}
                  rel={isExternal(project) ? "noreferrer" : undefined}
                >
                  {project.title}
                </a>
              </h3>
              <p>{project.summary}</p>
            </li>
          ))
        }
      </ol>

      <a class="text-link no-print" href="/projects">See everything I made</a>
    </section>

    <p class="print-footer print-only">eirikbreen.com</p>

    <section class="resume-section contact-section no-print" aria-labelledby="resume-contact-title">
      <h2 id="resume-contact-title">Get in touch</h2>
      <p class="section-copy">Best reached by email. LinkedIn is there if you prefer that route.</p>
      <ul class="contact-list">
        <li>
          <a class="text-link" href={`mailto:${resumeProfile.email}`}>{resumeProfile.email}</a>
        </li>
        <li>
          <a class="text-link" href={resumeProfile.linkedin} target="_blank" rel="noreferrer">
            LinkedIn
          </a>
        </li>
        <li>
          <a class="text-link" href={resumeProfile.github} target="_blank" rel="noreferrer">
            GitHub
          </a>
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>

<script>
  const printButton = document.querySelector("[data-print-resume]");

  if (printButton instanceof HTMLButtonElement) {
    printButton.addEventListener("click", () => {
      window.print();
    });
  }
</script>

<style>
  .resume-page {
    width: min(100%, 42rem);
    margin-inline: auto;
  }

  .intro {
    margin-bottom: clamp(2.75rem, 7vw, 4rem);
  }

  .experience-dates,
  .experience-stack span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  h1,
  h2,
  h3 {
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 400;
  }

  .role-line {
    margin: 0.9rem 0 0;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 1rem;
  }

  .lede,
  .section-copy,
  .experience-body > p,
  .highlights,
  .work-list p {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .lede {
    max-width: 36rem;
    margin: 1.1rem 0 0;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.4rem;
    margin-top: 1.35rem;
  }

  .print-button {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    cursor: pointer;
  }

  .print-button:hover {
    color: var(--text);
  }

  .resume-section {
    margin-bottom: clamp(2.75rem, 7vw, 4rem);
  }

  .resume-section h2 {
    margin: 0 0 1.35rem;
    font-size: clamp(1.35rem, 3.4vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .experience-list,
  .work-list,
  .skill-group ul,
  .contact-list,
  .highlights {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .experience:last-child {
    border-bottom: 1px solid var(--border);
  }

  .experience-dates {
    margin: 0.35rem 0 0;
  }

  .experience-body h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .experience-org {
    margin: 0.35rem 0 0.9rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.86rem;
  }

  .experience-body > p {
    margin: 0 0 0.85rem;
  }

  .highlights {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding-left: 1.1rem;
    list-style: disc;
  }

  .highlights li::marker {
    color: var(--faint);
  }

  .experience-stack {
    margin: 1rem 0 0;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .experience-stack span {
    display: block;
    margin-bottom: 0.3rem;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--border);
  }

  .skill-group {
    padding-top: 1.25rem;
  }

  .skill-group h3 {
    margin: 0 0 0.7rem;
    font-size: 1rem;
  }

  .skill-group li {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .section-copy {
    margin: -0.4rem 0 1.25rem;
  }

  .work-list {
    border-top: 1px solid var(--border);
  }

  .work-list li {
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--border);
  }

  .work-list h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }

  .work-list h3 a {
    color: var(--text);
    text-decoration-color: var(--faint);
  }

  .work-list p {
    margin: 0;
    font-size: 0.88rem;
  }

  .work-list + .text-link {
    display: inline-block;
    margin-top: 1.25rem;
  }

  .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
  }

  .text-link {
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .text-link:hover {
    color: var(--text);
  }

  .contact-section {
    margin-bottom: 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .resume-contact {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (max-width: 36rem) {
    .experience {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .experience-dates {
      margin: 0 0 0.35rem;
    }

    .skill-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .skill-group {
      padding-block: 1.1rem;
      border-bottom: 1px solid var(--border);
    }
  }

  @media print {
    .resume-page {
      width: 100%;
      max-width: none;
      color: var(--text-secondary);
    }

    .intro {
      display: flex;
      flex-direction: column;
      margin-bottom: 0.9rem;
      padding-bottom: 0;
      border-bottom: 0;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    h1.page-title {
      max-width: none;
      color: var(--text);
      font-size: 28pt;
      letter-spacing: -0.04em;
      line-height: 0.95;
    }

    .role-line {
      margin-top: 0.3rem;
      font-size: 11pt;
    }

    .lede {
      order: 4;
      max-width: none;
      margin-top: 0.7rem;
      font-size: 9.25pt;
      line-height: 1.4;
    }

    .intro-actions {
      order: 3;
      display: block;
      margin-top: 0.4rem;
      padding-bottom: 0.65rem;
      border-bottom: 1.75pt solid var(--text);
    }

    .resume-contact {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0;
    }

    .resume-contact li {
      display: flex;
      align-items: baseline;
      font-family: var(--font-sans);
      font-size: 9pt;
    }

    .resume-contact li:not(:last-child)::after {
      content: "·";
      margin-inline: 0.55em;
      color: var(--accent);
    }

    .resume-contact a,
    .resume-contact .text-link {
      color: var(--text-secondary);
      text-decoration: none;
      text-decoration-line: none;
    }

    .resume-section {
      margin-bottom: 0.85rem;
    }

    .resume-keep {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .resume-section h2 {
      margin: 0 0 0.1rem;
      padding-bottom: 0.32rem;
      border-bottom: 0.7pt solid var(--text);
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 8pt;
      letter-spacing: 0.16em;
      line-height: 1.2;
      text-transform: uppercase;
      break-after: avoid;
      page-break-after: avoid;
    }

    .experience {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      position: relative;
      padding-block: 0.62rem;
      border-top: 0;
      border-bottom: 0.45pt solid var(--border);
    }

    .experience:last-child {
      border-bottom: 0.45pt solid var(--border);
    }

    .experience-dates {
      position: absolute;
      top: 0.58rem;
      right: 0;
      display: block;
      margin: 0;
      font-size: 8pt;
      line-height: 1.2;
      font-variant-numeric: tabular-nums;
      text-align: right;
      text-transform: none;
      white-space: nowrap;
    }

    .experience-dates span {
      display: inline;
    }

    .experience-body h3,
    .experience-org {
      break-after: avoid;
      page-break-after: avoid;
    }

    .experience-body h3 {
      padding-right: 4.1cm;
      font-size: 11pt;
      line-height: 1.2;
    }

    .experience-org {
      margin: 0.1rem 0 0.32rem;
      font-size: 9pt;
    }

    .highlights {
      gap: 0.16rem;
      padding-left: 0.95rem;
    }

    .highlights li {
      font-size: 9pt;
      line-height: 1.35;
    }

    .highlights li::marker {
      color: var(--accent);
    }

    .experience-stack {
      margin: 0.35rem 0 0;
      font-size: 8pt;
      line-height: 1.35;
    }

    .experience-stack span {
      display: inline;
      margin: 0 0.35rem 0 0;
      text-transform: none;
    }

    .experience-stack span::after {
      content: ":";
    }

    .skill-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.12rem;
      padding: 0.35rem 0 0.15rem;
      border: 0;
    }

    .skill-group {
      display: grid;
      grid-template-columns: 3.8cm minmax(0, 1fr);
      gap: 0.28rem 0.8rem;
      align-items: baseline;
      padding: 0.12rem 0;
      border: 0;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .skill-group:last-child {
      border-bottom: 0;
    }

    .skill-group h3 {
      margin: 0;
      color: var(--text);
      font-family: var(--font-sans);
      font-size: 9pt;
    }

    .skill-group ul {
      display: block;
    }

    .skill-group li {
      display: inline;
      font-size: 9pt;
      line-height: 1.4;
    }

    .skill-group li:not(:last-child)::after {
      content: " · ";
      color: var(--faint);
    }

    .work-list {
      border-top: 0;
    }

    .work-list li {
      padding-block: 0.38rem;
      border-bottom: 0;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .work-list h3 {
      display: inline;
      margin: 0;
      font-size: 9.5pt;
    }

    .work-list h3::after {
      content: " — ";
      color: var(--muted);
    }

    .work-list p {
      display: inline;
      font-size: 8.5pt;
      line-height: 1.35;
    }

    .print-footer {
      margin: 0.9rem 0 0;
      padding-top: 0.4rem;
      border-top: 0.45pt solid var(--border);
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 7pt;
      letter-spacing: 0.08em;
    }
  }
</style>
