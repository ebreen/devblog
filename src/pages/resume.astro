---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../lib/projects";
import { experience, resumeProfile, skillGroups } from "../lib/resume";

const selectedWork = projects.slice(0, 4);
---

<BaseLayout
  title="Resume"
  description="Resume for Eirik Breen, a systems consultant in Oslo working on Linux, Kubernetes, and platform operations."
>
  <article class="page resume-page">
    <header class="intro">
      <p class="kicker">Resume</p>
      <h1>Eirik Breen</h1>
      <p class="role-line">{resumeProfile.role} · {resumeProfile.location}</p>
      <p class="lede">{resumeProfile.intro}</p>
      <p class="availability">Available · {resumeProfile.availability}</p>

      <div class="intro-actions">
        <a class="text-link" href={`mailto:${resumeProfile.email}`}>{resumeProfile.email}</a>
        <button class="print-button" type="button" data-print-resume>
          Print / save PDF
        </button>
      </div>
    </header>

    <section class="resume-section" aria-labelledby="experience-title">
      <p class="section-label">Career</p>
      <h2 id="experience-title">Professional experience</h2>

      <ol class="experience-list">
        {
          experience.map((role) => (
            <li class="experience">
              <p class="experience-dates">
                <time datetime={role.startDateTime}>{role.start}</time>
                <span aria-hidden="true"> — </span>
                {role.current ? (
                  <time datetime={new Date().toISOString().slice(0, 7)}>{role.end}</time>
                ) : (
                  <time datetime={role.endDateTime}>{role.end}</time>
                )}
              </p>

              <div class="experience-body">
                <h3>{role.title}</h3>
                <p class="experience-org">
                  {role.company}
                  <span aria-hidden="true"> · </span>
                  {role.location}
                </p>

                {role.summary.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}

                <p class="experience-stack">
                  <span>Daily stack</span>
                  {role.stack.join(", ")}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="resume-section" aria-labelledby="stack-title">
      <p class="section-label">The stack</p>
      <h2 id="stack-title">What I work with</h2>

      <div class="skill-grid">
        {
          skillGroups.map((group) => (
            <section class="skill-group" aria-labelledby={`skill-${group.id}`}>
              <h3 id={`skill-${group.id}`}>{group.title}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section class="resume-section" aria-labelledby="selected-work-title">
      <p class="section-label">Selected work</p>
      <h2 id="selected-work-title">After-hours tools</h2>
      <p class="section-copy">A few personal projects that show how I like to build. The full list is on the made page.</p>

      <ol class="work-list">
        {
          selectedWork.map((project, index) => (
            <li>
              <span class="work-index">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>
                  <a href={project.href} target="_blank" rel="noreferrer">
                    {project.title}
                  </a>
                </h3>
                <p>{project.summary}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <a class="text-link" href="/projects">See everything I made</a>
    </section>

    <section class="resume-section contact-section" aria-labelledby="resume-contact-title">
      <p class="section-label">Contact</p>
      <h2 id="resume-contact-title">Get in touch</h2>
      <p class="section-copy">
        Best reached by email. LinkedIn has the formal version if you need it.
      </p>
      <ul class="contact-list">
        <li>
          <a class="text-link" href={`mailto:${resumeProfile.email}`}>{resumeProfile.email}</a>
        </li>
        <li>
          <a class="text-link" href={resumeProfile.linkedin} target="_blank" rel="noreferrer">
            LinkedIn
          </a>
        </li>
        <li>
          <a class="text-link" href={resumeProfile.github} target="_blank" rel="noreferrer">
            GitHub
          </a>
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>

<script>
  const printButton = document.querySelector("[data-print-resume]");

  if (printButton instanceof HTMLButtonElement) {
    printButton.addEventListener("click", () => {
      window.print();
    });
  }
</script>

<style>
  .resume-page {
    width: min(100%, 42rem);
    margin-inline: auto;
  }

  .intro {
    margin-bottom: clamp(2.75rem, 7vw, 4rem);
  }

  .kicker,
  .section-label,
  .availability,
  .experience-dates,
  .experience-stack span,
  .work-index {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  .kicker,
  .section-label {
    margin: 0 0 0.85rem;
  }

  h1,
  h2,
  h3 {
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 400;
  }

  h1 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 3.15rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .role-line {
    margin: 0.7rem 0 0;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  .lede,
  .section-copy,
  .experience-body > p,
  .work-list p {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .lede {
    max-width: 36rem;
    margin: 1.1rem 0 0;
  }

  .availability {
    margin: 1.1rem 0 0;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.4rem;
    margin-top: 1.35rem;
  }

  .print-button {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    cursor: pointer;
  }

  .print-button:hover {
    color: var(--text);
  }

  .resume-section {
    margin-bottom: clamp(2.75rem, 7vw, 4rem);
  }

  .resume-section h2 {
    margin: 0 0 1.35rem;
    font-size: clamp(1.35rem, 3.4vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .experience-list,
  .work-list,
  .skill-group ul,
  .contact-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .experience:last-child {
    border-bottom: 1px solid var(--border);
  }

  .experience-dates {
    margin: 0.35rem 0 0;
  }

  .experience-body h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .experience-org {
    margin: 0.35rem 0 0.9rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.86rem;
  }

  .experience-body > p {
    margin: 0 0 0.85rem;
  }

  .experience-stack {
    margin: 1rem 0 0;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .experience-stack span {
    display: block;
    margin-bottom: 0.3rem;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--border);
  }

  .skill-group {
    padding-top: 1.25rem;
  }

  .skill-group h3 {
    margin: 0 0 0.7rem;
    font-size: 1rem;
  }

  .skill-group li {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .section-copy {
    margin: -0.4rem 0 1.25rem;
  }

  .work-list {
    border-top: 1px solid var(--border);
  }

  .work-list li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--border);
  }

  .work-index {
    padding-top: 0.3rem;
    color: var(--faint);
  }

  .work-list h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }

  .work-list h3 a {
    color: var(--text);
    text-decoration-color: var(--faint);
  }

  .work-list p {
    margin: 0;
    font-size: 0.88rem;
  }

  .work-list + .text-link {
    display: inline-block;
    margin-top: 1.25rem;
  }

  .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
  }

  .text-link {
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .text-link:hover {
    color: var(--text);
  }

  .contact-section {
    margin-bottom: 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 36rem) {
    .experience {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .experience-dates {
      margin: 0 0 0.35rem;
    }

    .skill-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .skill-group {
      padding-block: 1.1rem;
      border-bottom: 1px solid var(--border);
    }
  }

  @media print {
    .intro-actions,
    .print-button {
      display: none;
    }

    .resume-page {
      width: 100%;
    }

    .resume-section {
      break-inside: avoid;
    }
  }
</style>
